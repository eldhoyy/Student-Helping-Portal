// KTU Student Ecosystem — PostgreSQL / Supabase ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role { ADMIN STUDENT }
enum Status { DRAFT PUBLISHED ARCHIVED }
enum CategoryType { RESOURCE ARTICLE NOTICE DOWNLOAD GUIDE }
enum ResourceType {
  NOTES
  PDF_BOOK
  PREVIOUS_QUESTION
  MODEL_QUESTION_PAPER
  ASSIGNMENT
  ASSIGNMENT_SOLUTION
  SYLLABUS
  IMPORTANT_QUESTIONS
  QUESTION_BANK
  LAB_MANUAL
  STUDY_MATERIAL
  TEXTBOOK
  VIDEO_TUTORIAL
  OTHER
}
enum NoticeType { UNIVERSITY EXAM SCHOLARSHIP GENERAL }
enum GuideType { ADMISSION SCHOLARSHIP INTERNSHIP CAREER RESEARCH }
enum BookmarkType { RESOURCE ARTICLE }

model User {