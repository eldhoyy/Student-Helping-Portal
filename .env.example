# Supabase PostgreSQL
# Use the pooled connection string for DATABASE_URL in Vercel/runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Supabase connection used by Prisma migrations when needed.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth.js / Auth.js configuration
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional seed settings (never commit real credentials)
SEED_ADMIN_EMAIL="admin@ktu.local"
SEED_ADMIN_PASSWORD="change-me-before-running-seed"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
# Server-only Supabase secret key. Never expose this to the browser.
SUPABASE_SECRET_KEY="replace-with-supabase-secret-key"
